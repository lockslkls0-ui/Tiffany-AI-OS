#!/usr/bin/env bash
touch /tmp/tiffany_parle.lock
trap 'rm -f /tmp/tiffany_parle.lock' EXIT
TEXTE="${!#}"
CLEAN=$(echo "$TEXTE" | sed 's/\*//g; s/🌹//g' | tr -s ' ')
[ -z "$CLEAN" ] && exit 0
MODE=$(cat "$HOME/tiffany/voice/mode_voix.txt" 2>/dev/null | tr -d '[:space:]')
if [ "$MODE" = "piper" ] && [ -x "$HOME/tiffany/voice/piper" ] && [ -f "$HOME/tiffany/voice/voix_active.onnx" ]; then
    echo "$CLEAN" | "$HOME/tiffany/voice/piper" --model "$HOME/tiffany/voice/voix_active.onnx" --output_raw 2>/dev/null | aplay -r 16000 -f S16_LE -t raw -q 2>/dev/null
else
    /usr/bin/espeak-ng -v fr+f5 -s 145 -p 48 "$CLEAN" >/dev/null 2>&1
fi
