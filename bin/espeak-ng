#!/usr/bin/env bash
touch /tmp/tiffany_parle.lock
trap 'rm -f /tmp/tiffany_parle.lock' EXIT
TEXTE="${!#}"
CLEAN=$(echo "$TEXTE" | sed 's/\*//g; s/🌹//g; s/[[:cntrl:]]//g' | tr -s ' ')
[ -z "$CLEAN" ] && exit 0

VOICE_DIR="$HOME/tiffany/voice"
MODE=$(cat "$VOICE_DIR/mode_voix.txt" 2>/dev/null | tr -d '[:space:]')
MOD="$VOICE_DIR/voix_active.onnx"
[ ! -f "$MOD" ] && MOD="$VOICE_DIR/fr_FR-siwis-low.onnx"

if [ "$MODE" = "piper" ] && [ -f "$MOD" ]; then
    if [ -x "$VOICE_DIR/piper" ]; then
        echo "$CLEAN" | "$VOICE_DIR/piper" --model "$MOD" --output_raw 2>/dev/null | aplay -r 16000 -f S16_LE -t raw -q 2>/dev/null && exit 0
    elif command -v piper >/dev/null 2>&1; then
        echo "$CLEAN" | piper --model "$MOD" --output_raw 2>/dev/null | aplay -r 16000 -f S16_LE -t raw -q 2>/dev/null && exit 0
    elif [ -x "$HOME/.local/bin/piper" ]; then
        echo "$CLEAN" | "$HOME/.local/bin/piper" --model "$MOD" --output_raw 2>/dev/null | aplay -r 16000 -f S16_LE -t raw -q 2>/dev/null && exit 0
    elif python3 -c "import piper" >/dev/null 2>&1; then
        echo "$CLEAN" | python3 -m piper --model "$MOD" --output_raw 2>/dev/null | aplay -r 16000 -f S16_LE -t raw -q 2>/dev/null && exit 0
    fi
fi
/usr/bin/espeak-ng -v fr+f5 -s 145 -p 48 "$CLEAN" >/dev/null 2>&1
