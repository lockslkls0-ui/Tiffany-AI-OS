#!/usr/bin/env bash
[ -f "/tmp/tiffany_mute.flag" ] && exit 0
TEXTE="$*"
[ -z "$TEXTE" ] && exit 0

(
    flock -w 20 9 || exit 0
    touch /tmp/tiffany_parle.lock
    trap 'rm -f /tmp/tiffany_parle.lock' EXIT

    MODE=$(cat "$HOME/tiffany/voice/mode_voix.txt" 2>/dev/null | tr -d '[:space:]')
    MOD="$HOME/tiffany/voice/fr_FR-siwis-low.onnx"

    if [ "$MODE" = "piper" ] && [ -f "$MOD" ]; then
        if [ -x "$HOME/tiffany/voice/piper" ]; then
            echo "$TEXTE" | "$HOME/tiffany/voice/piper" --model "$MOD" --output_raw 2>/dev/null | aplay -r 16000 -f S16_LE -t raw -q 2>/dev/null
        elif command -v piper >/dev/null 2>&1; then
            echo "$TEXTE" | piper --model "$MOD" --output_raw 2>/dev/null | aplay -r 16000 -f S16_LE -t raw -q 2>/dev/null
        else
            /usr/bin/espeak-ng -v fr "$TEXTE" >/dev/null 2>&1
        fi
    else
        /usr/bin/espeak-ng -v fr "$TEXTE" >/dev/null 2>&1
    fi
) 9>/tmp/tiffany_audio_queue.lock
