#!/usr/bin/env bash
if [[ "$TIFFANY_MOBILE" != "1" && -x /usr/bin/zenity ]]; then
    exec /usr/bin/zenity "$@"
fi

MODE="info"
TITRE="Tiffany AI"
TEXTE=""
RAW_ARGS=()
CHAMPS=()
NB_COLS=0
CHECKLIST=0
PRINT_COL=1

while [[ $# -gt 0 ]]; do
    case "$1" in
        --entry) MODE="entry"; shift ;;
        --forms) MODE="forms"; shift ;;
        --question) MODE="question"; shift ;;
        --list) MODE="list"; shift ;;
        --progress) MODE="progress"; shift ;;
        --info|--warning|--error|--text-info|--notification) MODE="info"; shift ;;
        --checklist|--radiolist) CHECKLIST=1; shift ;;
        --title=*) TITRE="${1#--title=}"; shift ;;
        --title) TITRE="$2"; shift 2 ;;
        --text=*) TEXTE="${1#--text=}"; shift ;;
        --text) TEXTE="$2"; shift 2 ;;
        --add-entry=*) CHAMPS+=("${1#--add-entry=}"); shift ;;
        --add-entry) CHAMPS+=("$2"); shift 2 ;;
        --column=*) NB_COLS=$((NB_COLS + 1)); shift ;;
        --column) NB_COLS=$((NB_COLS + 1)); shift 2 ;;
        --print-column=*) PRINT_COL="${1#--print-column=}"; shift ;;
        --print-column) PRINT_COL="$2"; shift 2 ;;
        --extra-button=*) RAW_ARGS+=("${1#--extra-button=}"); shift ;;
        --width=*|--height=*|--separator=*|--cancel-label=*|--hide-header|--auto-close|--timeout=*) shift ;;
        *) RAW_ARGS+=("$1"); shift ;;
    esac
done

if [[ "$MODE" == "progress" ]]; then
    cat >/dev/null
    exit 0
fi

[[ "$**" == *"--timeout"* ]] && exit 0
[[ -v TEXTE && ! -t 0 ]] && TEXTE=$(cat)

OPTIONS=()
declare -A MAP_RETOUR

if [[ "$MODE" == "list" && ${#RAW_ARGS[@]} -gt 0 ]]; then
    if [[ $NB_COLS -gt 1 && ${#RAW_ARGS[@]} -ge $NB_COLS ]]; then
        i=0
        while [[ $i -lt ${#RAW_ARGS[@]} ]]; do
            if [[ $CHECKLIST -eq 1 && $NB_COLS -ge 3 ]]; then
                VAL_RET="${RAW_ARGS[$((i + PRINT_COL - 1))]}"
                LABEL="${RAW_ARGS[$((i + 1))]}. ${RAW_ARGS[$((i + 2))]}"
                [[ $NB_COLS -ge 4 ]] && LABEL="$LABEL (${RAW_ARGS[$((i + 3))]})"
            else
                VAL_RET="${RAW_ARGS[$((i + PRINT_COL - 1))]}"
                LABEL="${RAW_ARGS[$i]}"
                [[ -n "${RAW_ARGS[$((i + 1))]}" ]] && LABEL="$LABEL -- ${RAW_ARGS[$((i + 1))]}"
            fi
            OPTIONS+=("$LABEL")
            MAP_RETOUR["$LABEL"]="$VAL_RET"
            i=$((i + NB_COLS))
        done
    else
        for item in "${RAW_ARGS[@]}"; do
            OPTIONS+=("$item")
            MAP_RETOUR["$item"]="$item"
        done
    fi
fi

[[ "$MODE" == "question" && ${#OPTIONS[@]} -eq 0 ]] && OPTIONS=("Oui" "Non")
[[ "$MODE" == "info" && ${#OPTIONS[@]} -eq 0 ]] && OPTIONS=("OK")

ask_mobile() {
    local m_mode="$1"
    local m_title="$2"
    local m_text="$3"
    shift 3
    local qid="$(date +%s%N)"

    python3 -c '
import json, sys
data = {
    "id": sys.argv[1],
    "mode": sys.argv[2],
    "title": sys.argv[3],
    "text": sys.argv[4],
    "options": sys.argv[5:]
}
with open("/tmp/tiffany_mob_prompt.json", "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False)
' "$qid" "$m_mode" "$m_title" "$m_text" "$@"
    local ans_file="/tmp/tiffany_mob_ans_${qid}.json"
    for _ in $(seq 1 240); do
        if [[ -f "$ans_file" ]]; then
            local res
            res=$(python3 -c '
import json, sys
d = json.load(open(sys.argv[1], encoding="utf-8"))
if d.get("cancel"): sys.exit(2)
print(d.get("value", ""))
' "$ans_file")
            local code=$?
            rm -f "$ans_file" /tmp/tiffany_mob_prompt.json
            [[ $code -eq 2 ]] && return 2
            echo "$res"
            return 0
        fi
        sleep 0.5
    done
    rm -f /tmp/tiffany_mob_prompt.json
    return 1
}

RES=$(ask_mobile "$MODE" "$TITRE" "$TEXTE" "${OPTIONS[@]}")
CODE=$?
[[ $CODE -ne 0 ]] && exit 1

if [[ "$MODE" == "question" ]]; then
    [[ "$RES" == "Oui" ]] && exit 0 || exit 1
fi

if [[ "$MODE" == "list" && -n "${MAP_RETOUR[$RES]}" ]]; then
    echo "${MAP_RETOUR[$RES]]"
else
    echo "$RES"
fi
exit 0
