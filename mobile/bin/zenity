#!/usr/bin/env bash

TYPE="info"
TEXTE=""
TITRE="Tiffany AI"
COLONNES=()
OPTIONS=()

# 1. Extraction propre de tous les paramètres envoyés par Tiffany
while [[ $# -gt 0 ]]; do
    case "$1" in
        --info|--warning|--error|--question|--entry|--list|--text-info|--notification|--progress)
            TYPE="${1#--}"
            shift
            ;;
        --text=*)
            TEXTE="${1#--text=}"
            shift
            ;;
        --text)
            TEXTE="$2"
            shift 2
            ;;
        --title=*)
            TITRE="${1#--title=}"
            shift
            ;;
        --title)
            TITRE="$2"
            shift 2
            ;;
        --column=*)
            COLONNES+=("${1#--column=}")
            shift
            ;;
        --column)
            COLONNES+=("$2")
            shift 2
            ;;
        --width=*|--height=*|--hide-header|--radiolist|--checklist|--print-column=*)
            shift
            ;;
        *)
            # Tout le reste correspond aux sous-options d'une liste (--list)
            OPTIONS+=("$1")
            shift
            ;;
    esac
done

# Si le texte arrive par un tube (stdin, ex: cat resultat.txt | zenity --text-info)
if [[ -z "$TEXTE" && ! -t 0 ]]; then
    TEXTE=$(cat)
fi

# 2. Sauvegarde systématique dans le flux mobile pour ne jamais rien perdre
{
    echo "=========================================="
    echo "[$(date '+%H:%M:%S')] $TITRE ($TYPE)"
    echo "------------------------------------------"
    echo "$TEXTE"
    [[ ${#OPTIONS[@]} -gt 0 ]] && printf "Option : %s\n" "${OPTIONS[@]}"
} >> /tmp/tiffany_mobile_feed.log

# 3. Affichage et interaction directe dans le cadre mobile
case "$TYPE" in
    list)
        echo -e "\n╔══════════════════════════════════════════╗" >/dev/tty
        echo -e "║ 📌 $TITRE" >/dev/tty
        echo -e "╚══════════════════════════════════════════╝" >/dev/tty
        [[ -n "$TEXTE" ]] && echo -e "$TEXTE\n" >/dev/tty
        
        for i in "${!OPTIONS[@]}"; do
            echo "  [$((i+1))] ${OPTIONS[$i]}" >/dev/tty
        done
        
        echo "" >/dev/tty
        read -rp "👉 Votre choix (numéro) : " CHOIX </dev/tty
        if [[ "$CHOIX" =~ ^[0-9]+$ ]] && (( CHOIX >= 1 && CHOIX <= ${#OPTIONS[@]} )); then
            echo "${OPTIONS[$((CHOIX-1))]}"
            exit 0
        else
            exit 1
        fi
        ;;
    entry)
        echo -e "\n┌── ✏️  $TITRE ───────────────────────────" >/dev/tty
        read -rp "│ $TEXTE : " REPONSE </dev/tty
        echo "$REPONSE"
        exit 0
        ;;
    question)
        echo -e "\n┌── ❓ $TITRE ───────────────────────────" >/dev/tty
        read -rp "│ $TEXTE (o/n) : " REPONSE </dev/tty
        [[ "$REPONSE" =~ ^[oOyY] ]] && exit 0 || exit 1
        ;;
    *)
        # Cadre lisible pour toutes les réponses et résultats de commandes
        echo -e "\n╔══════════════════════════════════════════╗" >/dev/tty
        echo -e "║ 🤖 $TITRE" >/dev/tty
        echo -e "╠══════════════════════════════════════════╣" >/dev/tty
        echo -e "$TEXTE" >/dev/tty
        echo -e "╚══════════════════════════════════════════╝\n" >/dev/tty
        exit 0
        ;;
esac
