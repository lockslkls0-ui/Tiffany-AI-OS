#!/usr/bin/env python3
import sys, os, json, time, uuid, glob

# Si pas lance depuis le telephone, passer au vrai zenity du PC
if os.environ.get("TIFFANY_MOBILE") != "1":
    os.execv("/usr/bin/zenity", ["/usr/bin/zenity"] + sys.argv[1:])

args = sys.argv[1:]
mode = "info"
titre = "Tiffany"
texte = ""
options = []

i = 0
while i < len(args):
    a = args[i]
    if a in ("--entry", "--password"): mode = "entry"
    elif a in ("--list", "--radiolist", "--checklist"): mode = "list"
    elif a == "--question": mode = "question"
    elif a == "--file-selection": mode = "file"
    elif a in ("--info", "--warning", "--error", "--text-info"): mode = "info"
    elif a.startswith("--title="): titre = a.split("=", 1).pop()
    elif a == "--title" and i + 1 < len(args): titre = args[i+1]; i += 1
    elif a.startswith("--text="): texte = a.split("=", 1).pop()
    elif a == "--text" and i + 1 < len(args): texte = args[i+1]; i += 1
    elif not a.startswith("--"):
        options.append(a)
    i += 1

if mode == "file":
    fichiers = []
    for d in ("~/Téléchargements", "~/Downloads", "~/Desktop", "~/Bureau", "~/Documents", "~/tiffany"):
        fichiers.extend(sorted(glob.glob(os.path.expanduser(d) + "/*"))[:15])
    options = [f for f in fichiers if os.path.isfile(f)][:25]
    mode = "list"

if mode == "question" and not options:
    options = ["Oui", "Non"]

# Si c'est juste un message d'information, on l'enregistre pour le telephone et on rend la main
if mode == "info":
    open("/tmp/tiffany_mob_info.txt", "a", encoding="utf-8").write(f"\n📌 {titre} : {texte}\n")
    sys.exit(0)

# Sinon, on publie la question pour le telephone et on attend la reponse de l'utilisateur
qid = str(uuid.uuid4())[:8]
q_file = "/tmp/tiffany_mob_prompt.json"
r_file = f"/tmp/tiffany_mob_ans_{qid}.json"

open(q_file, "w", encoding="utf-8").write(json.dumps({
    "id": qid, "mode": mode, "title": titre, "text": texte, "options": options
}))

debut = time.time()
while time.time() - debut < 120:
    if os.path.exists(r_file):
        rep = json.loads(open(r_file, encoding="utf-8").read())
        try: os.remove(r_file)
        except Exception: pass
        try: os.remove(q_file)
        except Exception: pass
        if rep.get("cancel"):
            sys.exit(1)
        val = rep.get("value", "")
        if mode == "question":
            sys.exit(0 if val.lower() in ("oui", "yes", "ok", "1") else 1)
        print(val)
        sys.exit(0)
    time.sleep(0.25)

try: os.remove(q_file)
except Exception: pass
sys.exit(1)
