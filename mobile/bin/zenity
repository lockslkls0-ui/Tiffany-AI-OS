#!/usr/bin/env bash

# Si lancé depuis le PC (sans TIFFANY_MOBILE=1), utiliser le vrai zenity système
if [[ "$TIFFANY_MOBILE" != "1" && -x /usr/bin/zenity ]]; then
    exec /usr/bin/zenity "$@"
fi

MODE="info"
TITRE="Tiffany AI"
TEXTE=""
OPTIONS=()
CHAMPS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --entry) MODE="entry"; shift ;;
        --forms) MODE="forms"; shift ;;
        --question) MODE="question"; shift ;;
        --list) MODE="list"; shift ;;
        --info|--warning|--error|--text-info|--notification) MODE="info"; shift ;;
        --title=*) TITRE="${1#--title=}"; shift ;;
        --title) TITRE="$2"; shift 2 ;;
        --text=*) TEXTE="${1#--text=}"; shift ;;
        --text) TEXTE="$2"; shift 2 ;;
        --add-entry=*) CHAMPS+=("${1#--add-entry=}"); shift ;;
        --add-entry) CHAMPS+=("$2"); shift 2 ;;
        --column=*|--width=*|--height=*|--print-column=*|--separator=*) shift ;;
        --column) shift 2 ;;
        --hide-header|--radiolist|--checklist) shift ;;
        *) OPTIONS+=("$1"); shift ;;
    esac
done

[[ -z "$TEXTE" && ! -t 0 ]] && TEXTE=$(cat)
[[ "$MODE" == "question" && ${#OPTIONS[@]} -eq 0 ]] && OPTIONS=("Oui" "Non")
[[ "$MODE" == "info" && ${#OPTIONS[@]} -eq 0 ]] && OPTIONS=("OK")

# Fonction interne pour poser une question sur l'interface mobile 8486
ask_mobile() {
    local m_mode="$1"
    local m_title="$2"
    local m_text="$3"
    shift 3
    local qid="$(date +%s%N)"

    python3 -c '
import json, sys
data = {
    "id": sys.argv,
    "mode": sys.argv,
    "title": sys.argv,
    "text": sys.argv,
    "options": sys.argv[5:]
}
with open("/tmp/tiffany_mob_prompt.json", "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False)
' "$qid" "$m_mode" "$m_title" "$m_text" "$@"

    local ans_file="/tmp/tiffany_mob_ans_${qid}.json"
    for _ in $(seq 1 120); do
        if [[ -f "$ans_file" ]]; then
            local res
            res=$(python3 -c '
import json, sys
d = json.load(open(sys.argv, encoding="utf-8"))
if d.get("cancel"): sys.exit(2)
print(d.get("value", ""))
' "$ans_file")
            local code=$?
            rm -f "$ans_file" /tmp/tiffany_mob_prompt.json
            [[ $code -eq 2 ]] && return 2
            echo "$res"
            return 0
        fi
        sleep 0.5
    done
    rm -f /tmp/tiffany_mob_prompt.json
    return 1
}

# Mode formulaire (--forms) : pose chaque champ l'un après l'autre sur le téléphone et assemble avec |
if [[ "$MODE" == "forms" ]]; then
    [[ ${#CHAMPS[@]} -eq 0 ]] && CHAMPS=("Saisie :")
    RESULTATS=()
    for idx in "${!CHAMPS[@]}"; do
        REP=$(ask_mobile "entry" "$TITRE ($((idx+1))/${#CHAMPS[@]})" "${TEXTE}\n\n👉 ${CHAMPS[$idx]}")
        CODE=$?
        [[ $CODE -ne 0 ]] && exit 1
        RESULTATS+=("$REP")
    done
    (IFS="|"; echo "${RESULTATS[*]}")
    exit 0
fi

# Autres modes (entry, question, list, info)
REP=$(ask_mobile "$MODE" "$TITRE" "$TEXTE" "${OPTIONS[@]}")
CODE=$?
[[ $CODE -ne 0 ]] && exit 1

if [[ "$MODE" == "question" ]]; then
    [[ "$REP" == "Oui" ]] && exit 0 || exit 1
fi
echo "$REP"
exit 0
