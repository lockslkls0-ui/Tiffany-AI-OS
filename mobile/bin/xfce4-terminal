#!/usr/bin/env bash
if [ "$TIFFANY_MOBILE" != "1" ]; then
    exec /usr/bin/xfce4-terminal "$@"
fi
# Extraire la commande passee apres -e ou -x et l'executer directement pour renvoyer le texte au telephone
CMD=""
while [ $# -gt 0 ]; do
    case "$1" in
        -e|-x|--command) shift; CMD="$1"; break ;;
        --command=*) CMD="${1#*=}"; break ;;
    esac
    shift
done
[ -n "$CMD" ] && eval "$CMD" </dev/null
